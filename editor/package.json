{
  "name": "sphinx-typst-render-editor",
  "private": true,
  "version": "0.0.0",
  "description": "The in-browser editor shipped inside sphinx-typst-render: the pdf.js viewer plus a fill-in add-on.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "coverage": "node coverage.mjs",
    "lint": "biome lint .",
    "check": "pnpm run lint && pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.22.0",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "c8": "12.0.0",
    "esbuild": "0.28.2"
  }
}
